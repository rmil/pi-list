FROM ebutech/pi-list

# Fix: -map_channel was removed in ffmpeg 5.x.
# Replace with -filter_complex pan equivalent in the compiled dist files.
COPY docker/patch-pcap.js /tmp/patch-pcap.js
COPY docker/patch-crossCorrelation.js /tmp/patch-crossCorrelation.js
RUN node /tmp/patch-pcap.js && node /tmp/patch-crossCorrelation.js
